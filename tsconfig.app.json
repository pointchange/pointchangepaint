{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    // "src/page/main/env.d.ts",
    // "src/page/screenshot/env.d.ts",
    // "src/page/main/*",
    // "src/page/main/*.vue",
    // "src/page/screenshot/*.vue",
    // "src/page/screenshot/*",
    // "src/page/**/env.d.ts",
    "src/page/**/*.vue",
    "src/page/**/*",
    "src/preload/*",
    "src/preload/*.d.ts",
    "src/main/*",
    "src/env.d copy.ts",
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@main/*": [
        "./src/page/main/*",
      ],
      "@screenshot/*": [
        "./src/page/screenshot/*",
      ],
    }
  },
}